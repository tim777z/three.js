# three.js Environment Configuration Example
# Copy this file to .env and customize for your environment

# Node.js version (managed by .nvmrc)
# NODE_VERSION=18.20.0

# Build configuration
# BUILD_TARGET=webgl
# MINIFY_OUTPUT=true

# Development server
# DEV_SERVER_PORT=8080
# DEV_SERVER_HOST=localhost

# Testing
# TEST_BROWSERS=ChromeHeadless,FirefoxHeadless
# TEST_TIMEOUT=10000

# Linting and formatting
# ESLINT_CACHE=true
# PRETTIER_CACHE=true

# CI/CD
# CI_NODE_VERSIONS=18.x,20.x,22.x
# DEPLOY_ON_TAG=true

# Security
# NPM_AUDIT_LEVEL=high
# DEPENDENCY_UPDATE_ENABLED=true